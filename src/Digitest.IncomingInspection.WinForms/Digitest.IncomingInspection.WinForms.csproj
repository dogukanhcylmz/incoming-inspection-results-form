<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Digitest.IncomingInspection.WinForms</RootNamespace>
    <AssemblyName>DigitestGirdiMuayene</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
    <SatelliteResourceLanguages>tr;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Digitest.IncomingInspection.Core\Digitest.IncomingInspection.Core.csproj" />
    <ProjectReference Include="..\Digitest.IncomingInspection.Data\Digitest.IncomingInspection.Data.csproj" />
    <ProjectReference Include="..\Digitest.IncomingInspection.Reporting\Digitest.IncomingInspection.Reporting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.Local.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- Logo tek yerde durur (Reporting/Assets); ekran başlığı için çıktı klasörüne kopyalanır. -->
    <None Include="..\Digitest.IncomingInspection.Reporting\Assets\logo_digitest.png" Link="Assets\logo_digitest.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Forms\MainForm.cs" SubType="Form" />
    <Compile Update="Forms\InspectionEditForm.cs" SubType="Form" />
    <Compile Update="Forms\DocumentInfoForm.cs" SubType="Form" />
  </ItemGroup>

</Project>
